def send(samples, seq):
    body = b"AM" + bytes([PROTOCOL_VERSION, seq & 0xFF, len(samples)])
    body += struct.pack("<%dh" % len(samples), *samples)
    _serial.write(body + bytes([sum(body) & 0xFF]))
