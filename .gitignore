# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python
*.egg
*.egg-info/
dist/
build/
.eggs/
pip-wheel-metadata/
*.so

# Virtual environments
.venv/
venv/
env/
ENV/

# Live board config — runtime artifact on each board, not in source control
config/config.yaml

# Access config — real IPs, SSH users; use animon.example.yaml as template
config/animon.yaml

# Board wiring staging — dev-machine copies of each board's live config.yaml
# Use config/boards/example.yaml as the template (that file IS tracked)
config/boards/*.yaml
!config/boards/example.yaml

# Node desired-state files — real node IDs, not for public history
# Use config/nodes/example.yaml as the template (that file IS tracked)
config/nodes/*.yaml
!config/nodes/example.yaml

# Secrets and credentials
.env
*.key
*.pem

