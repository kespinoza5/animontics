# tools/network/ap.secrets — gitignored, shell-sourced by setup_ap.sh
# Copy to "ap.secrets" (same directory) and fill in real values, OR set these
# as environment variables and run: AP_PASS=... sudo -E bash setup_ap.sh
#
# AP_SSID is optional (defaults to "animontics"); AP_PASS is required and must
# be an 8-63 character WPA2 passphrase.

AP_SSID="animontics"
AP_PASS="change-me-8-to-63-chars"
